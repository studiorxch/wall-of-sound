rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnMember(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // StudioRich operator identity: the ONE allowlist backing every
    // StudioRich-only capability in this app (Event Radio config, MAP
    // authoring, and any future one) -- deliberately an email allowlist
    // against the EXISTING Firebase Auth identity Member already uses, not
    // a second identity system, not a frontend secret, and not custom
    // claims (no Admin SDK access is available in this environment to set
    // them). Extend THIS list, never a frontend flag or a second list, to
    // add another StudioRich operator.
    function studioRichOperatorEmails() {
      return ['richardjlau@gmail.com'];
    }
    function isStudioRichOperator() {
      return isSignedIn() && request.auth.token.email in studioRichOperatorEmails();
    }

    // Event Radio Turnkey Operations V1: named alias, unchanged behavior --
    // kept so its own feature reads standalone.
    function isEventOperator() {
      return isStudioRichOperator();
    }

    // MAP / Blackbook / RADIO Integration Beta: same StudioRich identity,
    // named for its own call site so future context-specific entitlements
    // (e.g. a narrower "map authors" list, if ever needed) can diverge from
    // isEventOperator() without touching this one.
    function isStudioRichMapAuthor() {
      return isStudioRichOperator();
    }

    // A Mark-authoring `surfaceId` whose CONTEXT is StudioRich-only, not
    // member-open. `surfaceId` is already a required, immutable-after-
    // creation string on every Artwork (see hasValidArtworkV1Shape) and is
    // already proven unique per real context in this codebase --
    // "map:new-york" (the one live prefix, from
    // music/src/member/mapArtworkBridge.ts's SUBWAY_MAP_SURFACE_ID) is used
    // NOWHERE else: Blackbook's own surfaceId is "blackbook:...", and the
    // MAPS-in-Blackbook graffiti feature uses its own per-placement surface
    // ids, never this prefix. Extend the regex alternation below, never a
    // second field or a client-supplied flag, to add a future restricted
    // context (WALL/TRAIN/STATION/MAP_TEMPLATE/EVENT) -- do not do so until
    // that context actually exists.
    function isRestrictedAuthoringSurface(surfaceId) {
      // Prefix check via slicing, not a regex `.matches()` -- this build's
      // own acceptance run showed regex evaluation pushing an
      // already-large `artworks` rule over Firestore's per-request
      // expression-evaluation budget on some paths ("maximum of 1000
      // expressions" emulator warnings). A slice-and-compare is
      // functionally identical for a fixed literal prefix and measurably
      // cheaper.
      return surfaceId.size() >= 4 && surfaceId[0:4] == 'map:';
    }

    function hasExactMemberFields(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'photoURL',
          'accountStatus',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
          'onboardingVersion'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'accountStatus',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
          'onboardingVersion'
        ]);
    }

    function hasValidMemberShape(data, uid) {
      return hasExactMemberFields(data)
        && data.uid == uid
        && (data.displayName == null || data.displayName is string)
        && (data.photoURL == null || data.photoURL is string)
        && data.accountStatus in ['active', 'suspended', 'deleted']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastSeenAt is timestamp
        && data.onboardingVersion is int
        && data.onboardingVersion >= 1;
    }

    function hasValidArtworkStyle(style) {
      return style is map
        && style.keys().hasAll(['color', 'width', 'opacity'])
        && style.keys().hasOnly(['color', 'width', 'opacity'])
        && style.color is string
        && style.width is number
        && style.width > 0
        && style.opacity is number
        && style.opacity >= 0
        && style.opacity <= 1;
    }

    function hasValidArtworkStroke(stroke) {
      return stroke is map
        && stroke.keys().hasAll(['id', 'points', 'style'])
        && stroke.keys().hasOnly(['id', 'points', 'style'])
        && stroke.id is string
        && stroke.points is list
        && stroke.points.size() >= 2
        && hasValidArtworkStyle(stroke.style);
    }

    function hasValidArtworkShape(data) {
      return data.keys().hasAll([
          'creatorId',
          'createdAt',
          'updatedAt',
          'surface',
          'geometry',
          'state',
          'visibility'
        ])
        && data.keys().hasOnly([
          'creatorId',
          'createdAt',
          'updatedAt',
          'surface',
          'geometry',
          'state',
          'visibility'
        ])
        && data.creatorId is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.surface is map
        && data.surface.keys().hasOnly(['type'])
        && data.surface.type == 'map'
        && data.geometry is map
        && data.geometry.keys().hasAll(['format', 'strokes'])
        && data.geometry.keys().hasOnly(['format', 'strokes'])
        && data.geometry.format == 'geographic-strokes-v1'
        && data.geometry.strokes is list
        && data.geometry.strokes.size() == 1
        && hasValidArtworkStroke(data.geometry.strokes[0])
        && data.state in ['draft', 'archived']
        && data.visibility == 'private';
    }

    function hasValidAuthoredZoom(mark) {
      return !('authoredZoom' in mark)
        || (mark.authoredZoom is number
          && mark.authoredZoom >= 0
          && mark.authoredZoom <= 24);
    }

    function hasValidStrokeMark(mark) {
      return mark is map
        && mark.keys().hasAll(['id', 'type', 'createdAt', 'geometry', 'style'])
        && mark.keys().hasOnly(['id', 'type', 'createdAt', 'geometry', 'style', 'material', 'authoredZoom'])
        && mark.id is string
        && mark.type == 'stroke'
        && mark.createdAt is timestamp
        && mark.geometry is map
        && mark.geometry.keys().hasAll(['format', 'points'])
        && mark.geometry.keys().hasOnly(['format', 'points'])
        && mark.geometry.format in ['geographic-stroke-v1', 'local-2d-stroke-v1']
        && mark.geometry.points is list
        && mark.geometry.points.size() >= 2
        && (!('material' in mark)
          || (mark.material is map
            && mark.material.keys().hasAll(['supplyId', 'materialId'])
            // Graphite Grades Foundation V1: 'variantId'/'profileVersion'
            // are OPTIONAL (not in hasAll) additive keys -- a legacy Mark
            // (only supplyId/materialId) remains valid unchanged.
            // BLACKBOOK Spray Physicality V1: 'capId' is an OPTIONAL
            // (not in hasAll) additive key, same pattern as
            // 'variantId'/'profileVersion' -- a legacy Spray Mark (no
            // capId) remains valid unchanged.
            && mark.material.keys().hasOnly(['supplyId', 'materialId', 'variantId', 'profileVersion', 'capId'])
            && ((mark.material.supplyId == 'pencil' && mark.material.materialId == 'graphite')
              || (mark.material.supplyId == 'pen' && mark.material.materialId == 'ink')
              || (mark.material.supplyId == 'marker' && mark.material.materialId == 'marker')
              || (mark.material.supplyId == 'mop' && mark.material.materialId == 'mop')
              || (mark.material.supplyId == 'spray' && mark.material.materialId == 'spray'))
            // Present together or absent together; only Pencil may carry a
            // grade; the grade itself is restricted to the seven calibrated
            // anchors -- deliberately NOT an open string (see this build's
            // own recon's security-boundary requirement).
            && (('variantId' in mark.material) == ('profileVersion' in mark.material))
            && (!('variantId' in mark.material)
              || (mark.material.supplyId == 'pencil'
                && mark.material.variantId in ['9h', '6h', '3h', 'hb', '3b', '6b', '9b']
                && mark.material.profileVersion is int
                && mark.material.profileVersion >= 1))
            // Only Spray may carry a capId, restricted to the known cap
            // registry (sprayDeposition.ts's SPRAY_CAP_PROFILES) --
            // deliberately not an open string, same boundary as the grade
            // allowlist above.
            && (!('capId' in mark.material)
              || (mark.material.supplyId == 'spray'
                && mark.material.capId in ['studiorich-stock', 'studiorich-fat']))))
        && hasValidAuthoredZoom(mark)
        && hasValidArtworkStyle(mark.style);
    }

    function hasValidMaterialErasureMark(mark) {
      return mark is map
        && mark.keys().hasAll(['id', 'type', 'createdAt', 'geometry', 'targetMaterialId', 'width'])
        && mark.keys().hasOnly(['id', 'type', 'createdAt', 'geometry', 'targetMaterialId', 'width', 'authoredZoom'])
        && mark.id is string
        && mark.type == 'material-erasure'
        && mark.createdAt is timestamp
        && mark.geometry is map
        && mark.geometry.keys().hasAll(['format', 'points'])
        && mark.geometry.keys().hasOnly(['format', 'points'])
        && mark.geometry.format in ['geographic-erasure-v1', 'local-2d-erasure-v1']
        && mark.geometry.points is list
        && mark.geometry.points.size() >= 2
        && mark.targetMaterialId == 'graphite'
        && mark.width is number
        && mark.width > 0
        && hasValidAuthoredZoom(mark);
    }

    function hasValidArtworkMark(mark) {
      return hasValidStrokeMark(mark) || hasValidMaterialErasureMark(mark);
    }

    function hasValidPageFrame(frame) {
      return frame is map
        && frame.keys().hasAll(['x', 'y', 'width', 'height'])
        && frame.keys().hasOnly(['x', 'y', 'width', 'height'])
        && frame.x is number
        && frame.y is number
        && frame.width is number
        && frame.width > 0
        && frame.height is number
        && frame.height > 0;
    }

    // BLACKBOOK CLEAR + Single-Step Undo V1 -- `allowEmptyMarks` is true
    // ONLY for the `update` rule below (an EXISTING, already-owned
    // document being rewritten with a possibly-empty `marks` array by
    // CLEAR, or restored to its pre-clear array by a single UNDO) --
    // NEVER for `create`, which still requires a real first Mark, per
    // this app's own "NEW must not persist an empty Artwork" invariant.
    // `data.marks[0]` is guarded (never indexed when the list is empty) --
    // indexing an empty list is itself a rules-evaluation error, not a
    // false/deny result.
    function hasValidArtworkV1Shape(data, allowEmptyMarks) {
      return data.keys().hasAll(['creatorId', 'surfaceId', 'artworkType', 'title', 'createdAt', 'updatedAt', 'composition', 'marks', 'state', 'visibility'])
        // Blackbook Spatial Workspace V1: 'pageFrame' is OPTIONAL (not in
        // hasAll) -- only a Blackbook-style bounded-page Artwork carries it;
        // Map and Blank Artworks are unaffected.
        && data.keys().hasOnly(['creatorId', 'surfaceId', 'artworkType', 'title', 'createdAt', 'updatedAt', 'composition', 'marks', 'state', 'visibility', 'pageFrame'])
        && (!data.keys().hasAny(['pageFrame']) || hasValidPageFrame(data.pageFrame))
        && data.creatorId is string
        && data.surfaceId is string
        // ARTWORK V2: an explicit, durable discriminator -- immutable after
        // creation (enforced in the `update` rule below, mirroring
        // surfaceId's own immutability clause), never inferred solely from
        // surfaceId.
        && data.artworkType in ['map', 'blank']
        // Presentation metadata only, never Artwork identity -- "" means no
        // meaningful title (legacy documents, or a caller like Blackbook
        // that never displays this field).
        && data.title is string
        && data.title.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.composition is map
        && data.composition.keys().hasAll(['bounds', 'startedAt', 'lastEditedAt'])
        && data.composition.keys().hasOnly(['bounds', 'startedAt', 'lastEditedAt'])
        && data.composition.bounds is map
        && ((data.composition.bounds.keys().hasAll(['west', 'south', 'east', 'north'])
            && data.composition.bounds.keys().hasOnly(['west', 'south', 'east', 'north'])
            && data.composition.bounds.west is number
            && data.composition.bounds.south is number
            && data.composition.bounds.east is number
            && data.composition.bounds.north is number)
          || (data.composition.bounds.keys().hasAll(['minX', 'minY', 'maxX', 'maxY'])
            && data.composition.bounds.keys().hasOnly(['minX', 'minY', 'maxX', 'maxY'])
            && data.composition.bounds.minX is number
            && data.composition.bounds.minY is number
            && data.composition.bounds.maxX is number
            && data.composition.bounds.maxY is number))
        && data.composition.startedAt is timestamp
        && data.composition.lastEditedAt is timestamp
        && data.marks is list
        && data.marks.size() >= (allowEmptyMarks ? 0 : 1)
        && data.marks.size() <= 500
        && (data.marks.size() == 0 || hasValidArtworkMark(data.marks[0]))
        && data.state in ['draft', 'archived']
        && data.visibility == 'private';
    }

    match /members/{uid} {
      allow read: if isOwnMember(uid);

      allow create: if isOwnMember(uid)
        && hasValidMemberShape(request.resource.data, uid)
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.onboardingVersion == 1;

      allow update: if isOwnMember(uid)
        && hasValidMemberShape(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'updatedAt',
          'lastSeenAt',
          'onboardingVersion'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSeenAt == request.time;

      allow delete: if false;
    }

    match /artworks/{artworkId} {
      allow read: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      allow create: if isSignedIn()
        // MAP / Blackbook / RADIO Integration Beta: a StudioRich-only
        // authoring CONTEXT, not a global creation ban -- an ordinary
        // member's Blackbook/other-surface Artwork is untouched by this
        // clause (isRestrictedAuthoringSurface is false for it), so this
        // does not weaken artwork creation in general. Evaluated BEFORE
        // the shape validators below on purpose: this build's own
        // acceptance run showed the existing dual-shape
        // `hasValidArtworkShape(...) || hasValidArtworkV1Shape(...)` check
        // is expensive enough that running it before a denial pushed
        // Firestore's per-request rule-evaluation budget over its limit
        // ("maximum of 1000 expressions") on the deny path. Cheap checks
        // first, expensive validation only once we know it's worth doing.
        && (!request.resource.data.keys().hasAny(['surfaceId'])
          || !isRestrictedAuthoringSurface(request.resource.data.surfaceId)
          || isStudioRichMapAuthor())
        && (hasValidArtworkShape(request.resource.data) || hasValidArtworkV1Shape(request.resource.data, false))
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.state == 'draft'
        && request.resource.data.visibility == 'private'
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['composition'])
          || (request.resource.data.composition.startedAt == request.time
            && request.resource.data.composition.lastEditedAt == request.time))
        && request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == request.auth.uid
        // Same StudioRich-only-context check as create, above, evaluated
        // against the EXISTING document's surfaceId (which create/immutability
        // already guarantees cannot change) -- so a member who could never
        // have created a "map:*" Artwork also can never append a Mark to
        // one, including one authored before this rule existed. Evaluated
        // BEFORE the expensive shape validators for the same
        // expression-budget reason documented on the create rule above.
        && (!resource.data.keys().hasAny(['surfaceId'])
          || !isRestrictedAuthoringSurface(resource.data.surfaceId)
          || isStudioRichMapAuthor())
        // BLACKBOOK CLEAR + Single-Step Undo V1 -- `allowEmptyMarks: true`
        // here only: an update to an EXISTING, already-owned document may
        // legitimately carry an empty `marks` array (CLEAR), never a
        // brand-new document (the `create` rule above still passes
        // `false`).
        && (hasValidArtworkShape(request.resource.data) || hasValidArtworkV1Shape(request.resource.data, true))
        && request.resource.data.createdAt == resource.data.createdAt
        && (!resource.data.keys().hasAny(['surfaceId']) || request.resource.data.surfaceId == resource.data.surfaceId)
        && (!resource.data.keys().hasAny(['artworkType']) || request.resource.data.artworkType == resource.data.artworkType)
        // Blackbook Spatial Workspace V1: the page frame is authored once,
        // at creation, and never resized/repositioned afterward -- same
        // immutability pattern as artworkType above.
        && (!resource.data.keys().hasAny(['pageFrame']) || request.resource.data.pageFrame == resource.data.pageFrame)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'geometry',
          'surface',
          'surfaceId',
          'title',
          'composition',
          'marks',
          'updatedAt',
          'state',
          'visibility'
        ])
        && (!request.resource.data.keys().hasAny(['composition']) || request.resource.data.composition.lastEditedAt == request.time)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    // Event Radio Turnkey Operations V1: StudioRich-owned program catalog
    // and active-event config. PUBLIC READ (no sign-in) -- a listener must
    // be able to resolve and play the event's music with zero StudioRich
    // authentication of their own; only WRITES are gated to the operator.
    match /radioPrograms/{programId} {
      allow read: if true;
      allow write: if isEventOperator()
        && request.resource.data.keys().hasAll(['title', 'manifestBaseUrl', 'trackCount', 'totalDurationSeconds'])
        // Batch 02H -- RADIO Program Package Identity Firestore Rules:
        // `stationId`/`bundleVersion` (Batch 02F's canonical, immutable
        // RADIO Package identity -- stationId === RadioWebManifest.stationId
        // === RadioPlaylist.id, bundleVersion === RadioWebManifest.bundleVersion)
        // are OPTIONAL here, matching the decodeRadioProgram contract exactly:
        // a legacy document with only the original four fields remains fully
        // valid and writable. Deliberately NOT required as a pair -- nothing
        // in this codebase reads either field yet (no write path, no
        // resolver consumption), so no coupling reason was found to justify
        // an atomicity constraint; each is validated independently, same as
        // the decoder already does.
        && request.resource.data.keys().hasOnly(['title', 'manifestBaseUrl', 'trackCount', 'totalDurationSeconds', 'stationId', 'bundleVersion'])
        && request.resource.data.title is string
        && request.resource.data.manifestBaseUrl is string
        && request.resource.data.trackCount is int
        && request.resource.data.trackCount >= 0
        && request.resource.data.totalDurationSeconds is number
        && request.resource.data.totalDurationSeconds >= 0
        && (!request.resource.data.keys().hasAny(['stationId'])
          || (request.resource.data.stationId is string && request.resource.data.stationId.size() > 0))
        && (!request.resource.data.keys().hasAny(['bundleVersion'])
          || (request.resource.data.bundleVersion is int && request.resource.data.bundleVersion > 0));
      allow delete: if isEventOperator();
    }

    match /eventProgram/{documentId} {
      allow read: if true;
      allow write: if isEventOperator()
        && documentId == 'current'
        && request.resource.data.keys().hasAll(['programId', 'playbackMode', 'startAtMs', 'endPolicy', 'status', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['programId', 'playbackMode', 'startAtMs', 'endPolicy', 'status', 'updatedAt', 'updatedBy'])
        && request.resource.data.programId is string
        && request.resource.data.playbackMode in ['personal', 'clock']
        && (request.resource.data.startAtMs == null || request.resource.data.startAtMs is number)
        && request.resource.data.endPolicy in ['stop', 'repeat']
        && request.resource.data.status in ['inactive', 'ready', 'active']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string;
      allow delete: if false;
    }

    // Batch 02L -- RADIO Channel + Rotation Persistence: a real collection
    // (not a fixed-path singleton like eventProgram/current) so a future
    // second Channel needs no rules restructuring. PUBLIC READ, same
    // rationale as radioPrograms/eventProgram -- a listener resolves the
    // rotation with zero StudioRich authentication.
    //
    // Per-element validation of `rotation.programIds` (every entry is a
    // real, non-empty string; no duplicates) is NOT expressible in this
    // rules language -- there is no per-element `list` predicate or
    // dedupe primitive here. That validation is enforced at the
    // application/repository boundary instead
    // (firestoreRadioChannelRepository.ts's own validate* functions),
    // with these rules providing the structural/type backstop: real map
    // shape, a non-empty list, a finite anchor.
    match /radioChannels/{channelId} {
      allow read: if true;
      allow write: if isEventOperator()
        && request.resource.data.keys().hasAll(['title', 'status', 'rotation', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['title', 'status', 'rotation', 'updatedAt', 'updatedBy'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.rotation is map
        && request.resource.data.rotation.keys().hasAll(['anchorAtMs', 'programIds'])
        && request.resource.data.rotation.keys().hasOnly(['anchorAtMs', 'programIds'])
        && request.resource.data.rotation.anchorAtMs is number
        && request.resource.data.rotation.programIds is list
        && request.resource.data.rotation.programIds.size() >= 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string;
      allow delete: if isEventOperator();
    }

    // RADIO-04 -- the canonical `Program x Channel x start x end` schedule
    // authority (see docs/architecture/radio/README.md). PUBLIC READ, same
    // rationale as every other RADIO catalog above -- the public program
    // guide and any listener resolve this with zero StudioRich
    // authentication. Split into `allow create`/`allow update` (unlike
    // radioPrograms/radioChannels' shared `allow write`) because the two
    // operations genuinely validate differently: create only ever writes
    // status "scheduled"; update may only flip status to "cancelled" --
    // every other field is immutable once created (a schedule OCCURRENCE
    // is corrected by cancelling it and creating a new one, never by
    // rewriting its own start/end/program in place). `allow delete: if
    // false` -- a schedule block is NEVER hard-deleted by any client,
    // reinforcing the "historical occurrences must not disappear" doctrine
    // at the rules layer itself, not just by omission from the app's own
    // repository interface.
    match /radioScheduleBlocks/{blockId} {
      allow read: if true;
      allow create: if isEventOperator()
        && request.resource.data.keys().hasAll(['channelId', 'programId', 'startAtMs', 'endAtMs', 'status', 'seriesId', 'recurrence', 'createdAt', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['channelId', 'programId', 'startAtMs', 'endAtMs', 'status', 'seriesId', 'recurrence', 'createdAt', 'updatedAt', 'updatedBy'])
        && request.resource.data.channelId is string
        && request.resource.data.channelId.size() > 0
        && request.resource.data.programId is string
        && request.resource.data.programId.size() > 0
        && request.resource.data.startAtMs is number
        && request.resource.data.endAtMs is number
        && request.resource.data.endAtMs > request.resource.data.startAtMs
        && request.resource.data.status == 'scheduled'
        && (request.resource.data.seriesId == null || (request.resource.data.seriesId is string && request.resource.data.seriesId.size() > 0))
        && (request.resource.data.recurrence == null || request.resource.data.recurrence is map)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string;
      allow update: if isEventOperator()
        && request.resource.data.keys().hasAll(['channelId', 'programId', 'startAtMs', 'endAtMs', 'status', 'seriesId', 'recurrence', 'createdAt', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['channelId', 'programId', 'startAtMs', 'endAtMs', 'status', 'seriesId', 'recurrence', 'createdAt', 'updatedAt', 'updatedBy'])
        && request.resource.data.channelId == resource.data.channelId
        && request.resource.data.programId == resource.data.programId
        && request.resource.data.startAtMs == resource.data.startAtMs
        && request.resource.data.endAtMs == resource.data.endAtMs
        && request.resource.data.seriesId == resource.data.seriesId
        && request.resource.data.status in ['scheduled', 'cancelled']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string;
      allow delete: if false;
    }
  }
}
