rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnMember(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Event Radio Turnkey Operations V1: the ENTIRE operator-authority
    // boundary for `radioPrograms`/`eventProgram`. Deliberately an email
    // allowlist against the EXISTING Firebase Auth identity Member already
    // uses -- not a second identity system, not a frontend secret, and not
    // custom claims (no Admin SDK access is available in this environment
    // to set them; see this build's own recon). Extend this list, never a
    // frontend flag, to add another operator.
    function isEventOperator() {
      return isSignedIn() && request.auth.token.email == 'whatsup@richielau.com';
    }

    function hasExactMemberFields(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'photoURL',
          'accountStatus',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
          'onboardingVersion'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'accountStatus',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
          'onboardingVersion'
        ]);
    }

    function hasValidMemberShape(data, uid) {
      return hasExactMemberFields(data)
        && data.uid == uid
        && (data.displayName == null || data.displayName is string)
        && (data.photoURL == null || data.photoURL is string)
        && data.accountStatus in ['active', 'suspended', 'deleted']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastSeenAt is timestamp
        && data.onboardingVersion is int
        && data.onboardingVersion >= 1;
    }

    function hasValidArtworkStyle(style) {
      return style is map
        && style.keys().hasAll(['color', 'width', 'opacity'])
        && style.keys().hasOnly(['color', 'width', 'opacity'])
        && style.color is string
        && style.width is number
        && style.width > 0
        && style.opacity is number
        && style.opacity >= 0
        && style.opacity <= 1;
    }

    function hasValidArtworkStroke(stroke) {
      return stroke is map
        && stroke.keys().hasAll(['id', 'points', 'style'])
        && stroke.keys().hasOnly(['id', 'points', 'style'])
        && stroke.id is string
        && stroke.points is list
        && stroke.points.size() >= 2
        && hasValidArtworkStyle(stroke.style);
    }

    function hasValidArtworkShape(data) {
      return data.keys().hasAll([
          'creatorId',
          'createdAt',
          'updatedAt',
          'surface',
          'geometry',
          'state',
          'visibility'
        ])
        && data.keys().hasOnly([
          'creatorId',
          'createdAt',
          'updatedAt',
          'surface',
          'geometry',
          'state',
          'visibility'
        ])
        && data.creatorId is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.surface is map
        && data.surface.keys().hasOnly(['type'])
        && data.surface.type == 'map'
        && data.geometry is map
        && data.geometry.keys().hasAll(['format', 'strokes'])
        && data.geometry.keys().hasOnly(['format', 'strokes'])
        && data.geometry.format == 'geographic-strokes-v1'
        && data.geometry.strokes is list
        && data.geometry.strokes.size() == 1
        && hasValidArtworkStroke(data.geometry.strokes[0])
        && data.state in ['draft', 'archived']
        && data.visibility == 'private';
    }

    function hasValidAuthoredZoom(mark) {
      return !('authoredZoom' in mark)
        || (mark.authoredZoom is number
          && mark.authoredZoom >= 0
          && mark.authoredZoom <= 24);
    }

    function hasValidStrokeMark(mark) {
      return mark is map
        && mark.keys().hasAll(['id', 'type', 'createdAt', 'geometry', 'style'])
        && mark.keys().hasOnly(['id', 'type', 'createdAt', 'geometry', 'style', 'material', 'authoredZoom'])
        && mark.id is string
        && mark.type == 'stroke'
        && mark.createdAt is timestamp
        && mark.geometry is map
        && mark.geometry.keys().hasAll(['format', 'points'])
        && mark.geometry.keys().hasOnly(['format', 'points'])
        && mark.geometry.format in ['geographic-stroke-v1', 'local-2d-stroke-v1']
        && mark.geometry.points is list
        && mark.geometry.points.size() >= 2
        && (!('material' in mark)
          || (mark.material is map
            && mark.material.keys().hasAll(['supplyId', 'materialId'])
            // Graphite Grades Foundation V1: 'variantId'/'profileVersion'
            // are OPTIONAL (not in hasAll) additive keys -- a legacy Mark
            // (only supplyId/materialId) remains valid unchanged.
            && mark.material.keys().hasOnly(['supplyId', 'materialId', 'variantId', 'profileVersion'])
            && ((mark.material.supplyId == 'pencil' && mark.material.materialId == 'graphite')
              || (mark.material.supplyId == 'pen' && mark.material.materialId == 'ink')
              || (mark.material.supplyId == 'marker' && mark.material.materialId == 'marker')
              || (mark.material.supplyId == 'mop' && mark.material.materialId == 'mop')
              || (mark.material.supplyId == 'spray' && mark.material.materialId == 'spray'))
            // Present together or absent together; only Pencil may carry a
            // grade; the grade itself is restricted to the seven calibrated
            // anchors -- deliberately NOT an open string (see this build's
            // own recon's security-boundary requirement).
            && (('variantId' in mark.material) == ('profileVersion' in mark.material))
            && (!('variantId' in mark.material)
              || (mark.material.supplyId == 'pencil'
                && mark.material.variantId in ['9h', '6h', '3h', 'hb', '3b', '6b', '9b']
                && mark.material.profileVersion is int
                && mark.material.profileVersion >= 1))))
        && hasValidAuthoredZoom(mark)
        && hasValidArtworkStyle(mark.style);
    }

    function hasValidMaterialErasureMark(mark) {
      return mark is map
        && mark.keys().hasAll(['id', 'type', 'createdAt', 'geometry', 'targetMaterialId', 'width'])
        && mark.keys().hasOnly(['id', 'type', 'createdAt', 'geometry', 'targetMaterialId', 'width', 'authoredZoom'])
        && mark.id is string
        && mark.type == 'material-erasure'
        && mark.createdAt is timestamp
        && mark.geometry is map
        && mark.geometry.keys().hasAll(['format', 'points'])
        && mark.geometry.keys().hasOnly(['format', 'points'])
        && mark.geometry.format in ['geographic-erasure-v1', 'local-2d-erasure-v1']
        && mark.geometry.points is list
        && mark.geometry.points.size() >= 2
        && mark.targetMaterialId == 'graphite'
        && mark.width is number
        && mark.width > 0
        && hasValidAuthoredZoom(mark);
    }

    function hasValidArtworkMark(mark) {
      return hasValidStrokeMark(mark) || hasValidMaterialErasureMark(mark);
    }

    function hasValidPageFrame(frame) {
      return frame is map
        && frame.keys().hasAll(['x', 'y', 'width', 'height'])
        && frame.keys().hasOnly(['x', 'y', 'width', 'height'])
        && frame.x is number
        && frame.y is number
        && frame.width is number
        && frame.width > 0
        && frame.height is number
        && frame.height > 0;
    }

    function hasValidArtworkV1Shape(data) {
      return data.keys().hasAll(['creatorId', 'surfaceId', 'artworkType', 'title', 'createdAt', 'updatedAt', 'composition', 'marks', 'state', 'visibility'])
        // Blackbook Spatial Workspace V1: 'pageFrame' is OPTIONAL (not in
        // hasAll) -- only a Blackbook-style bounded-page Artwork carries it;
        // Map and Blank Artworks are unaffected.
        && data.keys().hasOnly(['creatorId', 'surfaceId', 'artworkType', 'title', 'createdAt', 'updatedAt', 'composition', 'marks', 'state', 'visibility', 'pageFrame'])
        && (!data.keys().hasAny(['pageFrame']) || hasValidPageFrame(data.pageFrame))
        && data.creatorId is string
        && data.surfaceId is string
        // ARTWORK V2: an explicit, durable discriminator -- immutable after
        // creation (enforced in the `update` rule below, mirroring
        // surfaceId's own immutability clause), never inferred solely from
        // surfaceId.
        && data.artworkType in ['map', 'blank']
        // Presentation metadata only, never Artwork identity -- "" means no
        // meaningful title (legacy documents, or a caller like Blackbook
        // that never displays this field).
        && data.title is string
        && data.title.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.composition is map
        && data.composition.keys().hasAll(['bounds', 'startedAt', 'lastEditedAt'])
        && data.composition.keys().hasOnly(['bounds', 'startedAt', 'lastEditedAt'])
        && data.composition.bounds is map
        && ((data.composition.bounds.keys().hasAll(['west', 'south', 'east', 'north'])
            && data.composition.bounds.keys().hasOnly(['west', 'south', 'east', 'north'])
            && data.composition.bounds.west is number
            && data.composition.bounds.south is number
            && data.composition.bounds.east is number
            && data.composition.bounds.north is number)
          || (data.composition.bounds.keys().hasAll(['minX', 'minY', 'maxX', 'maxY'])
            && data.composition.bounds.keys().hasOnly(['minX', 'minY', 'maxX', 'maxY'])
            && data.composition.bounds.minX is number
            && data.composition.bounds.minY is number
            && data.composition.bounds.maxX is number
            && data.composition.bounds.maxY is number))
        && data.composition.startedAt is timestamp
        && data.composition.lastEditedAt is timestamp
        && data.marks is list
        && data.marks.size() >= 1
        && data.marks.size() <= 500
        && hasValidArtworkMark(data.marks[0])
        && data.state in ['draft', 'archived']
        && data.visibility == 'private';
    }

    match /members/{uid} {
      allow read: if isOwnMember(uid);

      allow create: if isOwnMember(uid)
        && hasValidMemberShape(request.resource.data, uid)
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.onboardingVersion == 1;

      allow update: if isOwnMember(uid)
        && hasValidMemberShape(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'updatedAt',
          'lastSeenAt',
          'onboardingVersion'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSeenAt == request.time;

      allow delete: if false;
    }

    match /artworks/{artworkId} {
      allow read: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      allow create: if isSignedIn()
        && (hasValidArtworkShape(request.resource.data) || hasValidArtworkV1Shape(request.resource.data))
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.state == 'draft'
        && request.resource.data.visibility == 'private'
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['composition'])
          || (request.resource.data.composition.startedAt == request.time
            && request.resource.data.composition.lastEditedAt == request.time))
        && request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == request.auth.uid
        && (hasValidArtworkShape(request.resource.data) || hasValidArtworkV1Shape(request.resource.data))
        && request.resource.data.createdAt == resource.data.createdAt
        && (!resource.data.keys().hasAny(['surfaceId']) || request.resource.data.surfaceId == resource.data.surfaceId)
        && (!resource.data.keys().hasAny(['artworkType']) || request.resource.data.artworkType == resource.data.artworkType)
        // Blackbook Spatial Workspace V1: the page frame is authored once,
        // at creation, and never resized/repositioned afterward -- same
        // immutability pattern as artworkType above.
        && (!resource.data.keys().hasAny(['pageFrame']) || request.resource.data.pageFrame == resource.data.pageFrame)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'geometry',
          'surface',
          'surfaceId',
          'title',
          'composition',
          'marks',
          'updatedAt',
          'state',
          'visibility'
        ])
        && (!request.resource.data.keys().hasAny(['composition']) || request.resource.data.composition.lastEditedAt == request.time)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    // Event Radio Turnkey Operations V1: StudioRich-owned program catalog
    // and active-event config. PUBLIC READ (no sign-in) -- a listener must
    // be able to resolve and play the event's music with zero StudioRich
    // authentication of their own; only WRITES are gated to the operator.
    match /radioPrograms/{programId} {
      allow read: if true;
      allow write: if isEventOperator()
        && request.resource.data.keys().hasAll(['title', 'manifestBaseUrl', 'trackCount', 'totalDurationSeconds'])
        && request.resource.data.keys().hasOnly(['title', 'manifestBaseUrl', 'trackCount', 'totalDurationSeconds'])
        && request.resource.data.title is string
        && request.resource.data.manifestBaseUrl is string
        && request.resource.data.trackCount is int
        && request.resource.data.trackCount >= 0
        && request.resource.data.totalDurationSeconds is number
        && request.resource.data.totalDurationSeconds >= 0;
      allow delete: if isEventOperator();
    }

    match /eventProgram/{documentId} {
      allow read: if true;
      allow write: if isEventOperator()
        && documentId == 'current'
        && request.resource.data.keys().hasAll(['programId', 'playbackMode', 'startAtMs', 'endPolicy', 'status', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['programId', 'playbackMode', 'startAtMs', 'endPolicy', 'status', 'updatedAt', 'updatedBy'])
        && request.resource.data.programId is string
        && request.resource.data.playbackMode in ['personal', 'clock']
        && (request.resource.data.startAtMs == null || request.resource.data.startAtMs is number)
        && request.resource.data.endPolicy in ['stop', 'repeat']
        && request.resource.data.status in ['inactive', 'ready', 'active']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string;
      allow delete: if false;
    }
  }
}
